# ──────────────────────────────────────────────────────────────
# NOVAIRA — environment variables
# Copy to `.env.local` for local dev. Set the same values in Vercel
# → Project → Settings → Environment Variables for production.
# ──────────────────────────────────────────────────────────────

# Supabase (server-only — never prefix these with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Resend (transactional email for the consultation form)
# Get an API key: https://resend.com → API Keys → Create
RESEND_API_KEY=
# Inbox that receives consultation notifications
NOTIFICATION_EMAIL=
# Must be a domain verified in the Resend dashboard
RESEND_FROM_EMAIL="NOVAIRA <hello@novairaworld.com>"

# PostHog (product analytics, client-side)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Cloudflare Turnstile (optional bot mitigation for the consultation form)
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# When both are unset the form still works (honeypot + time-to-submit + rate
# limit still apply); when both are set the server requires a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend webhook (deliverability events → notifications table)
# Create a webhook in Resend → Webhooks pointing to
# https://www.novairaworld.com/api/webhooks/resend and copy the signing
# secret (whsec_...) here. Without this the webhook endpoint returns 503.
RESEND_WEBHOOK_SECRET=

# Admin (HTTP Basic Auth for /admin/*). Fail closed: if either value is
# unset the admin routes return 503, never an unprotected page.
ADMIN_USER=
ADMIN_PASSWORD=

# Upstash Redis (optional, production-grade rate limiting)
# Create a database at https://console.upstash.com → Redis → Create. Grab
# the REST URL + REST token from the "REST API" tab. When both are set the
# rate limiter enforces limits globally across Vercel lambda instances;
# when unset it falls back to a per-instance in-memory Map (dev-friendly,
# but limits reset on cold start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Calendly inline embed URL (if/when you wire it below the form)
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link
